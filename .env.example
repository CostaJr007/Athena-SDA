# Copy this file to .env and fill in values (never commit .env)

# IBM watsonx.ai — Granite explains the ontology + object graph
# (scripts/serve_granite_explain.py). Without keys, the sidecar uses a
# local ontology walk (still not Bob).
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# Space-Track.org (optional — used only by download_spacetrack.py)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# Optional sidecar write token (POST/DELETE). Empty = local-dev open.
ATHENA_SIDECAR_TOKEN=
