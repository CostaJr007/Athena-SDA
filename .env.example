# Copy this file to .env and fill in values (never commit .env)

# Graph copilot (free). Get keys at:
#   Groq   — https://console.groq.com/keys
#   Tavily — https://app.tavily.com
# Without keys, Ask still works from the local graph walk.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
TAVILY_API_KEY=

# Optional leftover — not required for the demo.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# Space-Track.org (optional — used only by download_spacetrack.py)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# Optional sidecar write token (POST/DELETE). Empty = local-dev open.
ATHENA_SIDECAR_TOKEN=
