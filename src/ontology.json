{
  "ontology": "athena.sda.v1",
  "description": "Typed object model for Athena-SDA. Gotham-style categories Entity/Event/Document (Foundry type mapping). Inspiration: US 12,374,011 B2 object map; US 7,962,495 / 9,589,014 dynamic ontology; In-Q-Tel/CIA lineage is historical context only — no affiliation. dataset->object type, row->object, column->property, join->link type.",
  "objectTypes": {
    "Satellite": {
      "apiName": "Satellite",
      "gothamCategory": "Entity",
      "primaryKey": "noradId",
      "properties": {
        "noradId": { "dataType": "integer", "required": true },
        "name": { "dataType": "string" },
        "owner": { "dataType": "string" },
        "country": { "dataType": "string" },
        "role": { "dataType": "string", "enum": ["asset", "suspect", "baseline", "unknown"] },
        "purpose": { "dataType": "string" },
        "orbitClass": { "dataType": "string", "enum": ["LEO", "MEO", "GEO", "HEO"] },
        "status": {
          "dataType": "string",
          "enum": ["NOMINAL", "ANOMALY", "PAIR_ELEVATED", "CHANGE_RELEVANT", "ASSET_REGIME_NOISE", "CALIBRATION_BASELINE", "UNRELIABLE_DATA"]
        },
        "anomalyScore": { "dataType": "double" },
        "attentionScore": { "dataType": "double" }
      },
      "links": {
        "threatens": { "target": "Satellite", "multiplicity": "MANY", "description": "suspect -> protected asset pair (shadowing / RPO proxy)" },
        "threatenedBy": { "target": "Satellite", "multiplicity": "MANY", "description": "asset -> suspects in top_pairs (search-around)" },
        "hasAlert": { "target": "Alert", "multiplicity": "ONE", "description": "elevated noise / mil detect / non-nominal" },
        "validatedBy": { "target": "Case", "multiplicity": "MANY", "description": "walk-forward public t_peak (past-only IF)" },
        "weather": { "target": "Weather", "multiplicity": "ONE", "description": "GFZ F10.7/Ap/Kp window" },
        "fusedAs": { "target": "Evidence", "multiplicity": "ONE", "description": "Dempster-Shafer belief / conflict K" },
        "calibrationAnchor": { "target": "Satellite", "multiplicity": "MANY", "description": "baseline normality anchor" }
      }
    },
    "Alert": {
      "apiName": "Alert",
      "gothamCategory": "Event",
      "primaryKey": "alertId",
      "properties": {
        "alertId": { "dataType": "string", "required": true },
        "severity": { "dataType": "string", "enum": ["LOW", "WATCH", "ELEVATED", "CRITICAL"] },
        "status": { "dataType": "string", "enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED", "SUPPRESSED"] },
        "eventType": { "dataType": "string", "enum": ["SHADOWING", "RPO", "PROXIMITY", "MANEUVER", "PLATFORM_HEALTH", "CALIBRATION"] },
        "anomalyScore": { "dataType": "double" },
        "attentionScore": { "dataType": "double" },
        "raisedAt": { "dataType": "datetime" }
      },
      "links": {
        "target": { "target": "Satellite", "multiplicity": "ONE" },
        "source": { "target": "Satellite", "multiplicity": "ONE" }
      }
    },
    "Case": {
      "apiName": "Case",
      "gothamCategory": "Event",
      "primaryKey": "eventId",
      "properties": {
        "eventId": { "dataType": "string", "required": true },
        "tPeak": { "dataType": "datetime" },
        "hit": { "dataType": "boolean" },
        "isPlacebo": { "dataType": "boolean" },
        "leadDays": { "dataType": "double" }
      },
      "links": {
        "subject": { "target": "Satellite", "multiplicity": "ONE" },
        "samePeak": { "target": "Case", "multiplicity": "MANY", "description": "placebo or interest sharing t_peak calendar" }
      }
    },
    "Weather": {
      "apiName": "Weather",
      "gothamCategory": "Event",
      "primaryKey": "weatherId",
      "properties": {
        "weatherId": { "dataType": "string", "required": true },
        "f107": { "dataType": "double" },
        "apIndex": { "dataType": "double" },
        "geomagneticStorm": { "dataType": "boolean" }
      }
    },
    "Evidence": {
      "apiName": "Evidence",
      "gothamCategory": "Event",
      "primaryKey": "evidenceId",
      "properties": {
        "evidenceId": { "dataType": "string", "required": true },
        "beliefAnomalous": { "dataType": "double" },
        "conflictK": { "dataType": "double" }
      }
    },
    "Document": {
      "apiName": "Document",
      "gothamCategory": "Document",
      "primaryKey": "documentId",
      "properties": {
        "documentId": { "dataType": "string", "required": true },
        "title": { "dataType": "string" },
        "source": { "dataType": "string" }
      },
      "links": {
        "mentions": { "target": "Satellite", "multiplicity": "MANY" },
        "validatedBy": { "target": "Case", "multiplicity": "MANY" }
      }
    },
    "Sensor": {
      "apiName": "Sensor",
      "gothamCategory": "Entity",
      "primaryKey": "sensorId",
      "properties": {
        "sensorId": { "dataType": "string", "required": true },
        "network": { "dataType": "string" },
        "taskable": { "dataType": "boolean" },
        "taskingCost": { "dataType": "double" },
        "taskingState": { "dataType": "string", "enum": ["IDLE", "TASKED", "BUSY"] }
      }
    },
    "TaskingOrder": {
      "apiName": "TaskingOrder",
      "gothamCategory": "Event",
      "primaryKey": "orderId",
      "properties": {
        "orderId": { "dataType": "string", "required": true },
        "windowStart": { "dataType": "datetime" },
        "windowEnd": { "dataType": "datetime" },
        "state": { "dataType": "string", "enum": ["DRAFT", "VALIDATED", "APPROVED", "EXECUTING", "COMPLETED", "REJECTED"] },
        "kellyAllocation": { "dataType": "double" }
      },
      "links": {
        "target": { "target": "Satellite", "multiplicity": "ONE" },
        "sensor": { "target": "Sensor", "multiplicity": "ONE" }
      }
    }
  },
  "actionTypes": {
    "TaskSatellite": {
      "apiName": "TaskSatellite",
      "parameters": {
        "targetNorad": { "dataType": "integer" },
        "sensorId": { "dataType": "string" },
        "windowStart": { "dataType": "datetime" },
        "windowEnd": { "dataType": "datetime" }
      },
      "operations": [{ "type": "createObject", "objectTypeApiName": "TaskingOrder" }],
      "validateOnly": true,
      "description": "Create a sensor tasking order for a satellite (validated, not executed — operator approval required)."
    },
    "AcknowledgeAlert": {
      "apiName": "AcknowledgeAlert",
      "parameters": {
        "targetNorad": { "dataType": "integer" }
      },
      "validateOnly": true,
      "description": "Operator ACK on today's alert — writes the action log only (US 12,657,514 Actions)."
    },
    "OpenCase": {
      "apiName": "OpenCase",
      "parameters": {
        "targetNorad": { "dataType": "integer" },
        "eventId": { "dataType": "string" }
      },
      "validateOnly": true,
      "description": "Open a walk-forward case on this object — log only, does not change scores."
    },
    "ResolveAlert": {
      "apiName": "ResolveAlert",
      "parameters": { "targetNorad": { "dataType": "integer" } },
      "validateOnly": true,
      "description": "Close an acknowledged/open alert. Bookkeeping only — scores immutable."
    },
    "SuppressAlert": {
      "apiName": "SuppressAlert",
      "parameters": { "targetNorad": { "dataType": "integer" } },
      "validateOnly": true,
      "description": "Suppress a known/nuisance alert. Bookkeeping only — scores immutable."
    }
  }
}
